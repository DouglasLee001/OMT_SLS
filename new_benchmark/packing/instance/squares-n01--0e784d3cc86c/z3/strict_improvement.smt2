(set-option :timeout 3000)
(set-option :produce-models true)
; Integer minimum-area packing; fixed item orientations; touching boundaries allowed.
(set-logic QF_NIA)
(declare-fun W () Int)
(assert (>= W 1))
(assert (<= W 1))
(declare-fun H () Int)
(assert (>= H 1))
(assert (<= H 1))
(declare-fun x_0 () Int)
(assert (>= x_0 0))
(assert (<= x_0 1))
(declare-fun y_0 () Int)
(assert (>= y_0 0))
(assert (<= y_0 1))
(declare-fun area () Int)
(assert (>= area 1))
(assert (<= area 1))
(declare-fun cost () Int)
(assert (>= cost 1))
(assert (<= cost 1))
(assert (= area (* W H)))
(assert (= cost area))
(assert (<= (+ x_0 1) W))
(assert (<= (+ y_0 1) H))
(assert (< cost 1))
(check-sat)
