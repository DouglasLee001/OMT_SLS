; Integer minimum-area packing; fixed item orientations; touching boundaries allowed.
(set-logic QF_NIA)
(declare-fun W () Int)
(assert (>= W 2))
(assert (<= W 3))
(declare-fun H () Int)
(assert (>= H 2))
(assert (<= H 3))
(declare-fun x_0 () Int)
(assert (>= x_0 0))
(assert (<= x_0 3))
(declare-fun y_0 () Int)
(assert (>= y_0 0))
(assert (<= y_0 3))
(declare-fun x_1 () Int)
(assert (>= x_1 0))
(assert (<= x_1 3))
(declare-fun y_1 () Int)
(assert (>= y_1 0))
(assert (<= y_1 3))
(declare-fun area () Int)
(assert (>= area 5))
(assert (<= area 6))
(declare-fun cost () Int)
(assert (>= cost 5))
(assert (<= cost 6))
(assert (= area (* W H)))
(assert (= cost area))
(assert (<= (+ x_0 1) W))
(assert (<= (+ y_0 1) H))
(assert (<= (+ x_1 2) W))
(assert (<= (+ y_1 2) H))
(assert (or (<= (+ x_0 1) x_1) (<= (+ x_1 2) x_0) (<= (+ y_0 1) y_1) (<= (+ y_1 2) y_0)))
