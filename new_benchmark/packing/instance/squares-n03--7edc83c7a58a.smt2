; Integer minimum-area packing; fixed item orientations; touching boundaries allowed.
(set-logic QF_NIA)
(declare-fun W () Int)
(assert (>= W 3))
(assert (<= W 6))
(declare-fun H () Int)
(assert (>= H 3))
(assert (<= H 6))
(declare-fun x_0 () Int)
(assert (>= x_0 0))
(assert (<= x_0 6))
(declare-fun y_0 () Int)
(assert (>= y_0 0))
(assert (<= y_0 6))
(declare-fun x_1 () Int)
(assert (>= x_1 0))
(assert (<= x_1 6))
(declare-fun y_1 () Int)
(assert (>= y_1 0))
(assert (<= y_1 6))
(declare-fun x_2 () Int)
(assert (>= x_2 0))
(assert (<= x_2 6))
(declare-fun y_2 () Int)
(assert (>= y_2 0))
(assert (<= y_2 6))
(declare-fun area () Int)
(assert (>= area 14))
(assert (<= area 18))
(declare-fun cost () Int)
(assert (>= cost 14))
(assert (<= cost 18))
(assert (= area (* W H)))
(assert (= cost area))
(assert (<= (+ x_0 1) W))
(assert (<= (+ y_0 1) H))
(assert (<= (+ x_1 2) W))
(assert (<= (+ y_1 2) H))
(assert (<= (+ x_2 3) W))
(assert (<= (+ y_2 3) H))
(assert (or (<= (+ x_0 1) x_1) (<= (+ x_1 2) x_0) (<= (+ y_0 1) y_1) (<= (+ y_1 2) y_0)))
(assert (or (<= (+ x_0 1) x_2) (<= (+ x_2 3) x_0) (<= (+ y_0 1) y_2) (<= (+ y_2 3) y_0)))
(assert (or (<= (+ x_1 2) x_2) (<= (+ x_2 3) x_1) (<= (+ y_1 2) y_2) (<= (+ y_2 3) y_1)))
(minimize cost)
(check-sat)
