(set-option :timeout 3000)
(set-option :produce-models true)
; Integer minimum-area packing; fixed item orientations; touching boundaries allowed.
(set-logic QF_NIA)
(declare-fun W () Int)
(assert (>= W 4))
(assert (<= W 10))
(declare-fun H () Int)
(assert (>= H 4))
(assert (<= H 10))
(declare-fun x_0 () Int)
(assert (>= x_0 0))
(assert (<= x_0 10))
(declare-fun y_0 () Int)
(assert (>= y_0 0))
(assert (<= y_0 10))
(declare-fun x_1 () Int)
(assert (>= x_1 0))
(assert (<= x_1 10))
(declare-fun y_1 () Int)
(assert (>= y_1 0))
(assert (<= y_1 10))
(declare-fun x_2 () Int)
(assert (>= x_2 0))
(assert (<= x_2 10))
(declare-fun y_2 () Int)
(assert (>= y_2 0))
(assert (<= y_2 10))
(declare-fun x_3 () Int)
(assert (>= x_3 0))
(assert (<= x_3 10))
(declare-fun y_3 () Int)
(assert (>= y_3 0))
(assert (<= y_3 10))
(declare-fun area () Int)
(assert (>= area 30))
(assert (<= area 40))
(declare-fun cost () Int)
(assert (>= cost 30))
(assert (<= cost 40))
(assert (= area (* W H)))
(assert (= cost area))
(assert (<= (+ x_0 1) W))
(assert (<= (+ y_0 1) H))
(assert (<= (+ x_1 2) W))
(assert (<= (+ y_1 2) H))
(assert (<= (+ x_2 3) W))
(assert (<= (+ y_2 3) H))
(assert (<= (+ x_3 4) W))
(assert (<= (+ y_3 4) H))
(assert (or (<= (+ x_0 1) x_1) (<= (+ x_1 2) x_0) (<= (+ y_0 1) y_1) (<= (+ y_1 2) y_0)))
(assert (or (<= (+ x_0 1) x_2) (<= (+ x_2 3) x_0) (<= (+ y_0 1) y_2) (<= (+ y_2 3) y_0)))
(assert (or (<= (+ x_0 1) x_3) (<= (+ x_3 4) x_0) (<= (+ y_0 1) y_3) (<= (+ y_3 4) y_0)))
(assert (or (<= (+ x_1 2) x_2) (<= (+ x_2 3) x_1) (<= (+ y_1 2) y_2) (<= (+ y_2 3) y_1)))
(assert (or (<= (+ x_1 2) x_3) (<= (+ x_3 4) x_1) (<= (+ y_1 2) y_3) (<= (+ y_3 4) y_1)))
(assert (or (<= (+ x_2 3) x_3) (<= (+ x_3 4) x_2) (<= (+ y_2 3) y_3) (<= (+ y_3 4) y_2)))
(assert (= H 4))
(assert (= W 10))
(assert (= area 40))
(assert (= cost 40))
(assert (= x_0 0))
(assert (= x_1 1))
(assert (= x_2 3))
(assert (= x_3 6))
(assert (= y_0 0))
(assert (= y_1 0))
(assert (= y_2 0))
(assert (= y_3 0))
(assert (= cost 40))
(check-sat)
