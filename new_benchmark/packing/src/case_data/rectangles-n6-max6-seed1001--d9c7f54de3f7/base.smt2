(assert (>= cost 78))
(assert (<= cost 114))
(assert (= area (* W H)))
(assert (= cost area))
(assert (<= (+ x_0 1) W))
(assert (<= (+ y_0 2) H))
(assert (<= (+ x_1 1) W))
(assert (<= (+ y_1 5) H))
(assert (<= (+ x_2 4) W))
(assert (<= (+ y_2 2) H))
