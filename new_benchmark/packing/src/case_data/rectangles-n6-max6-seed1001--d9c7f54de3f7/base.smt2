(set-logic QF_NIA)
(declare-fun W () Int)
(assert (>= W 6))
(assert (<= W 19))
(declare-fun H () Int)
(assert (>= H 6))
(assert (<= H 19))
(declare-fun x_0 () Int)
(assert (>= x_0 0))
(assert (<= x_0 19))
