(assert (<= y_4 27))
(declare-fun x_5 () Int)
(assert (>= x_5 0))
(assert (<= x_5 27))
(declare-fun y_5 () Int)
(assert (>= y_5 0))
(assert (<= y_5 27))
(declare-fun area () Int)
(assert (>= area 77))
(assert (<= area 162))
(declare-fun cost () Int)
(assert (>= cost 77))
(assert (<= cost 162))
(assert (= area (* W H)))
(assert (= cost area))
(assert (<= (+ x_0 5) W))
(assert (<= (+ y_0 4) H))
(assert (<= (+ x_1 3) W))
(assert (<= (+ y_1 1) H))
(assert (<= (+ x_2 6) W))
(assert (<= (+ y_2 1) H))
(assert (<= (+ x_3 1) W))
(assert (<= (+ y_3 6) H))
(assert (<= (+ x_4 6) W))
(assert (<= (+ y_4 2) H))
(assert (<= (+ x_5 6) W))
(assert (<= (+ y_5 5) H))
(assert (or (<= (+ x_0 5) x_1) (<= (+ x_1 3) x_0) (<= (+ y_0 4) y_1) (<= (+ y_1 1) y_0)))
(assert (or (<= (+ x_0 5) x_2) (<= (+ x_2 6) x_0) (<= (+ y_0 4) y_2) (<= (+ y_2 1) y_0)))
(assert (or (<= (+ x_0 5) x_3) (<= (+ x_3 1) x_0) (<= (+ y_0 4) y_3) (<= (+ y_3 6) y_0)))
(assert (or (<= (+ x_0 5) x_4) (<= (+ x_4 6) x_0) (<= (+ y_0 4) y_4) (<= (+ y_4 2) y_0)))
(assert (or (<= (+ x_0 5) x_5) (<= (+ x_5 6) x_0) (<= (+ y_0 4) y_5) (<= (+ y_5 5) y_0)))
(assert (or (<= (+ x_1 3) x_2) (<= (+ x_2 6) x_1) (<= (+ y_1 1) y_2) (<= (+ y_2 1) y_1)))
(assert (or (<= (+ x_1 3) x_3) (<= (+ x_3 1) x_1) (<= (+ y_1 1) y_3) (<= (+ y_3 6) y_1)))
(assert (or (<= (+ x_1 3) x_4) (<= (+ x_4 6) x_1) (<= (+ y_1 1) y_4) (<= (+ y_4 2) y_1)))
(assert (or (<= (+ x_1 3) x_5) (<= (+ x_5 6) x_1) (<= (+ y_1 1) y_5) (<= (+ y_5 5) y_1)))
(assert (or (<= (+ x_2 6) x_3) (<= (+ x_3 1) x_2) (<= (+ y_2 1) y_3) (<= (+ y_3 6) y_2)))
(assert (or (<= (+ x_2 6) x_4) (<= (+ x_4 6) x_2) (<= (+ y_2 1) y_4) (<= (+ y_4 2) y_2)))
(assert (or (<= (+ x_2 6) x_5) (<= (+ x_5 6) x_2) (<= (+ y_2 1) y_5) (<= (+ y_5 5) y_2)))
(assert (or (<= (+ x_3 1) x_4) (<= (+ x_4 6) x_3) (<= (+ y_3 6) y_4) (<= (+ y_4 2) y_3)))
(assert (or (<= (+ x_3 1) x_5) (<= (+ x_5 6) x_3) (<= (+ y_3 6) y_5) (<= (+ y_5 5) y_3)))
(assert (or (<= (+ x_4 6) x_5) (<= (+ x_5 6) x_4) (<= (+ y_4 2) y_5) (<= (+ y_5 5) y_4)))
