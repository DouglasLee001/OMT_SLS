; Integer minimum-area packing; fixed item orientations; touching boundaries allowed.
(set-logic QF_NIA)
(declare-fun W () Int)
(assert (>= W 6))
(assert (<= W 27))
(declare-fun H () Int)
(assert (>= H 6))
(assert (<= H 27))
(declare-fun x_0 () Int)
(assert (>= x_0 0))
(assert (<= x_0 27))
(declare-fun y_0 () Int)
(assert (>= y_0 0))
(assert (<= y_0 27))
(declare-fun x_1 () Int)
(assert (>= x_1 0))
(assert (<= x_1 27))
(declare-fun y_1 () Int)
(assert (>= y_1 0))
(assert (<= y_1 27))
(declare-fun x_2 () Int)
(assert (>= x_2 0))
(assert (<= x_2 27))
