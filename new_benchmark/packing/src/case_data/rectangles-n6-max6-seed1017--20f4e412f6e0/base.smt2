; Integer minimum-area packing; fixed item orientations; touching boundaries allowed.
(set-logic QF_NIA)
(declare-fun W () Int)
(assert (>= W 4))
(assert (<= W 16))
(declare-fun H () Int)
(assert (>= H 6))
(assert (<= H 24))
(declare-fun x_0 () Int)
(assert (>= x_0 0))
(assert (<= x_0 16))
(declare-fun y_0 () Int)
(assert (>= y_0 0))
(assert (<= y_0 24))
(declare-fun x_1 () Int)
(assert (>= x_1 0))
(assert (<= x_1 16))
(declare-fun y_1 () Int)
(assert (>= y_1 0))
(assert (<= y_1 24))
(declare-fun x_2 () Int)
(assert (>= x_2 0))
(assert (<= x_2 16))
(declare-fun y_2 () Int)
(assert (>= y_2 0))
(assert (<= y_2 24))
(declare-fun x_3 () Int)
(assert (>= x_3 0))
(assert (<= x_3 16))
(declare-fun y_3 () Int)
(assert (>= y_3 0))
(assert (<= y_3 24))
(declare-fun x_4 () Int)
(assert (>= x_4 0))
(assert (<= x_4 16))
(declare-fun y_4 () Int)
(assert (>= y_4 0))
(assert (<= y_4 24))
(declare-fun x_5 () Int)
(assert (>= x_5 0))
(assert (<= x_5 16))
(declare-fun y_5 () Int)
(assert (>= y_5 0))
(assert (<= y_5 24))
(declare-fun area () Int)
(assert (>= area 53))
(assert (<= area 96))
(declare-fun cost () Int)
(assert (>= cost 53))
(assert (<= cost 96))
(assert (= area (* W H)))
(assert (= cost area))
(assert (<= (+ x_0 4) W))
(assert (<= (+ y_0 6) H))
(assert (<= (+ x_1 4) W))
(assert (<= (+ y_1 2) H))
(assert (<= (+ x_2 1) W))
(assert (<= (+ y_2 3) H))
(assert (<= (+ x_3 3) W))
(assert (<= (+ y_3 1) H))
(assert (<= (+ x_4 3) W))
(assert (<= (+ y_4 3) H))
(assert (<= (+ x_5 1) W))
(assert (<= (+ y_5 6) H))
(assert (or (<= (+ x_0 4) x_1) (<= (+ x_1 4) x_0) (<= (+ y_0 6) y_1) (<= (+ y_1 2) y_0)))
(assert (or (<= (+ x_0 4) x_2) (<= (+ x_2 1) x_0) (<= (+ y_0 6) y_2) (<= (+ y_2 3) y_0)))
(assert (or (<= (+ x_0 4) x_3) (<= (+ x_3 3) x_0) (<= (+ y_0 6) y_3) (<= (+ y_3 1) y_0)))
(assert (or (<= (+ x_0 4) x_4) (<= (+ x_4 3) x_0) (<= (+ y_0 6) y_4) (<= (+ y_4 3) y_0)))
(assert (or (<= (+ x_0 4) x_5) (<= (+ x_5 1) x_0) (<= (+ y_0 6) y_5) (<= (+ y_5 6) y_0)))
(assert (or (<= (+ x_1 4) x_2) (<= (+ x_2 1) x_1) (<= (+ y_1 2) y_2) (<= (+ y_2 3) y_1)))
(assert (or (<= (+ x_1 4) x_3) (<= (+ x_3 3) x_1) (<= (+ y_1 2) y_3) (<= (+ y_3 1) y_1)))
(assert (or (<= (+ x_1 4) x_4) (<= (+ x_4 3) x_1) (<= (+ y_1 2) y_4) (<= (+ y_4 3) y_1)))
(assert (or (<= (+ x_1 4) x_5) (<= (+ x_5 1) x_1) (<= (+ y_1 2) y_5) (<= (+ y_5 6) y_1)))
(assert (or (<= (+ x_2 1) x_3) (<= (+ x_3 3) x_2) (<= (+ y_2 3) y_3) (<= (+ y_3 1) y_2)))
(assert (or (<= (+ x_2 1) x_4) (<= (+ x_4 3) x_2) (<= (+ y_2 3) y_4) (<= (+ y_4 3) y_2)))
(assert (or (<= (+ x_2 1) x_5) (<= (+ x_5 1) x_2) (<= (+ y_2 3) y_5) (<= (+ y_5 6) y_2)))
(assert (or (<= (+ x_3 3) x_4) (<= (+ x_4 3) x_3) (<= (+ y_3 1) y_4) (<= (+ y_4 3) y_3)))
(assert (or (<= (+ x_3 3) x_5) (<= (+ x_5 1) x_3) (<= (+ y_3 1) y_5) (<= (+ y_5 6) y_3)))
(assert (or (<= (+ x_4 3) x_5) (<= (+ x_5 1) x_4) (<= (+ y_4 3) y_5) (<= (+ y_5 6) y_4)))
