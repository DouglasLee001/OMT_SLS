; Integer minimum-area packing; fixed item orientations; touching boundaries allowed.
(set-logic QF_NIA)
(declare-fun W () Int)
(assert (>= W 5))
(assert (<= W 19))
(declare-fun H () Int)
(assert (>= H 6))
(assert (<= H 22))
(declare-fun x_0 () Int)
(assert (>= x_0 0))
(assert (<= x_0 19))
(declare-fun y_0 () Int)
(assert (>= y_0 0))
(assert (<= y_0 22))
(declare-fun x_1 () Int)
(assert (>= x_1 0))
(assert (<= x_1 19))
(declare-fun y_1 () Int)
(assert (>= y_1 0))
(assert (<= y_1 22))
(declare-fun x_2 () Int)
(assert (>= x_2 0))
(assert (<= x_2 19))
(declare-fun y_2 () Int)
(assert (>= y_2 0))
(assert (<= y_2 22))
(declare-fun x_3 () Int)
(assert (>= x_3 0))
(assert (<= x_3 19))
(declare-fun y_3 () Int)
(assert (>= y_3 0))
(assert (<= y_3 22))
(declare-fun x_4 () Int)
(assert (>= x_4 0))
(assert (<= x_4 19))
(declare-fun y_4 () Int)
(assert (>= y_4 0))
(assert (<= y_4 22))
(declare-fun x_5 () Int)
(assert (>= x_5 0))
(assert (<= x_5 19))
(declare-fun y_5 () Int)
(assert (>= y_5 0))
(assert (<= y_5 22))
(declare-fun area () Int)
(assert (>= area 72))
(assert (<= area 114))
(declare-fun cost () Int)
(assert (>= cost 72))
(assert (<= cost 114))
(assert (= area (* W H)))
(assert (= cost area))
(assert (<= (+ x_0 5) W))
(assert (<= (+ y_0 1) H))
(assert (<= (+ x_1 2) W))
(assert (<= (+ y_1 3) H))
(assert (<= (+ x_2 1) W))
(assert (<= (+ y_2 4) H))
(assert (<= (+ x_3 4) W))
(assert (<= (+ y_3 6) H))
(assert (<= (+ x_4 5) W))
(assert (<= (+ y_4 5) H))
(assert (<= (+ x_5 2) W))
(assert (<= (+ y_5 4) H))
(assert (or (<= (+ x_0 5) x_1) (<= (+ x_1 2) x_0) (<= (+ y_0 1) y_1) (<= (+ y_1 3) y_0)))
(assert (or (<= (+ x_0 5) x_2) (<= (+ x_2 1) x_0) (<= (+ y_0 1) y_2) (<= (+ y_2 4) y_0)))
(assert (or (<= (+ x_0 5) x_3) (<= (+ x_3 4) x_0) (<= (+ y_0 1) y_3) (<= (+ y_3 6) y_0)))
(assert (or (<= (+ x_0 5) x_4) (<= (+ x_4 5) x_0) (<= (+ y_0 1) y_4) (<= (+ y_4 5) y_0)))
(assert (or (<= (+ x_0 5) x_5) (<= (+ x_5 2) x_0) (<= (+ y_0 1) y_5) (<= (+ y_5 4) y_0)))
(assert (or (<= (+ x_1 2) x_2) (<= (+ x_2 1) x_1) (<= (+ y_1 3) y_2) (<= (+ y_2 4) y_1)))
(assert (or (<= (+ x_1 2) x_3) (<= (+ x_3 4) x_1) (<= (+ y_1 3) y_3) (<= (+ y_3 6) y_1)))
(assert (or (<= (+ x_1 2) x_4) (<= (+ x_4 5) x_1) (<= (+ y_1 3) y_4) (<= (+ y_4 5) y_1)))
(assert (or (<= (+ x_1 2) x_5) (<= (+ x_5 2) x_1) (<= (+ y_1 3) y_5) (<= (+ y_5 4) y_1)))
(assert (or (<= (+ x_2 1) x_3) (<= (+ x_3 4) x_2) (<= (+ y_2 4) y_3) (<= (+ y_3 6) y_2)))
(assert (or (<= (+ x_2 1) x_4) (<= (+ x_4 5) x_2) (<= (+ y_2 4) y_4) (<= (+ y_4 5) y_2)))
(assert (or (<= (+ x_2 1) x_5) (<= (+ x_5 2) x_2) (<= (+ y_2 4) y_5) (<= (+ y_5 4) y_2)))
(assert (or (<= (+ x_3 4) x_4) (<= (+ x_4 5) x_3) (<= (+ y_3 6) y_4) (<= (+ y_4 5) y_3)))
(assert (or (<= (+ x_3 4) x_5) (<= (+ x_5 2) x_3) (<= (+ y_3 6) y_5) (<= (+ y_5 4) y_3)))
(assert (or (<= (+ x_4 5) x_5) (<= (+ x_5 2) x_4) (<= (+ y_4 5) y_5) (<= (+ y_5 4) y_4)))
