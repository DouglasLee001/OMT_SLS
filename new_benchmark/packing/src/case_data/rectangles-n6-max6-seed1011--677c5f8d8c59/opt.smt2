; Integer minimum-area packing; fixed item orientations; touching boundaries allowed.
(set-logic QF_NIA)
(declare-fun W () Int)
(assert (>= W 6))
(assert (<= W 21))
(declare-fun H () Int)
(assert (>= H 6))
(assert (<= H 21))
(declare-fun x_0 () Int)
(assert (>= x_0 0))
(assert (<= x_0 21))
(declare-fun y_0 () Int)
(assert (>= y_0 0))
(assert (<= y_0 21))
(declare-fun x_1 () Int)
(assert (>= x_1 0))
(assert (<= x_1 21))
(declare-fun y_1 () Int)
(assert (>= y_1 0))
(assert (<= y_1 21))
(declare-fun x_2 () Int)
(assert (>= x_2 0))
(assert (<= x_2 21))
(declare-fun y_2 () Int)
(assert (>= y_2 0))
(assert (<= y_2 21))
(declare-fun x_3 () Int)
(assert (>= x_3 0))
(assert (<= x_3 21))
(declare-fun y_3 () Int)
(assert (>= y_3 0))
(assert (<= y_3 21))
(declare-fun x_4 () Int)
(assert (>= x_4 0))
(assert (<= x_4 21))
(declare-fun y_4 () Int)
(assert (>= y_4 0))
(assert (<= y_4 21))
(declare-fun x_5 () Int)
(assert (>= x_5 0))
(assert (<= x_5 21))
(declare-fun y_5 () Int)
(assert (>= y_5 0))
(assert (<= y_5 21))
(declare-fun area () Int)
(assert (>= area 80))
(assert (<= area 126))
(declare-fun cost () Int)
(assert (>= cost 80))
(assert (<= cost 126))
(assert (= area (* W H)))
(assert (= cost area))
(assert (<= (+ x_0 3) W))
(assert (<= (+ y_0 3) H))
(assert (<= (+ x_1 1) W))
(assert (<= (+ y_1 4) H))
(assert (<= (+ x_2 2) W))
(assert (<= (+ y_2 6) H))
(assert (<= (+ x_3 4) W))
(assert (<= (+ y_3 4) H))
(assert (<= (+ x_4 6) W))
(assert (<= (+ y_4 4) H))
(assert (<= (+ x_5 5) W))
(assert (<= (+ y_5 3) H))
(assert (or (<= (+ x_0 3) x_1) (<= (+ x_1 1) x_0) (<= (+ y_0 3) y_1) (<= (+ y_1 4) y_0)))
(assert (or (<= (+ x_0 3) x_2) (<= (+ x_2 2) x_0) (<= (+ y_0 3) y_2) (<= (+ y_2 6) y_0)))
(assert (or (<= (+ x_0 3) x_3) (<= (+ x_3 4) x_0) (<= (+ y_0 3) y_3) (<= (+ y_3 4) y_0)))
(assert (or (<= (+ x_0 3) x_4) (<= (+ x_4 6) x_0) (<= (+ y_0 3) y_4) (<= (+ y_4 4) y_0)))
(assert (or (<= (+ x_0 3) x_5) (<= (+ x_5 5) x_0) (<= (+ y_0 3) y_5) (<= (+ y_5 3) y_0)))
(assert (or (<= (+ x_1 1) x_2) (<= (+ x_2 2) x_1) (<= (+ y_1 4) y_2) (<= (+ y_2 6) y_1)))
(assert (or (<= (+ x_1 1) x_3) (<= (+ x_3 4) x_1) (<= (+ y_1 4) y_3) (<= (+ y_3 4) y_1)))
(assert (or (<= (+ x_1 1) x_4) (<= (+ x_4 6) x_1) (<= (+ y_1 4) y_4) (<= (+ y_4 4) y_1)))
(assert (or (<= (+ x_1 1) x_5) (<= (+ x_5 5) x_1) (<= (+ y_1 4) y_5) (<= (+ y_5 3) y_1)))
(assert (or (<= (+ x_2 2) x_3) (<= (+ x_3 4) x_2) (<= (+ y_2 6) y_3) (<= (+ y_3 4) y_2)))
(assert (or (<= (+ x_2 2) x_4) (<= (+ x_4 6) x_2) (<= (+ y_2 6) y_4) (<= (+ y_4 4) y_2)))
(assert (or (<= (+ x_2 2) x_5) (<= (+ x_5 5) x_2) (<= (+ y_2 6) y_5) (<= (+ y_5 3) y_2)))
(assert (or (<= (+ x_3 4) x_4) (<= (+ x_4 6) x_3) (<= (+ y_3 4) y_4) (<= (+ y_4 4) y_3)))
(assert (or (<= (+ x_3 4) x_5) (<= (+ x_5 5) x_3) (<= (+ y_3 4) y_5) (<= (+ y_5 3) y_3)))
(assert (or (<= (+ x_4 6) x_5) (<= (+ x_5 5) x_4) (<= (+ y_4 4) y_5) (<= (+ y_5 3) y_4)))
(minimize cost)
(check-sat)
