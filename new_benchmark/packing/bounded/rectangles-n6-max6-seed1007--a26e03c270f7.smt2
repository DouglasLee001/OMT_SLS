; Integer minimum-area packing; fixed item orientations; touching boundaries allowed.
(set-logic QF_NIA)
(declare-fun W () Int)
(assert (>= W 6))
(assert (<= W 22))
(declare-fun H () Int)
(assert (>= H 6))
(assert (<= H 22))
(declare-fun x_0 () Int)
(assert (>= x_0 0))
(assert (<= x_0 22))
(declare-fun y_0 () Int)
(assert (>= y_0 0))
(assert (<= y_0 22))
(declare-fun x_1 () Int)
(assert (>= x_1 0))
(assert (<= x_1 22))
(declare-fun y_1 () Int)
(assert (>= y_1 0))
(assert (<= y_1 22))
(declare-fun x_2 () Int)
(assert (>= x_2 0))
(assert (<= x_2 22))
(declare-fun y_2 () Int)
(assert (>= y_2 0))
(assert (<= y_2 22))
(declare-fun x_3 () Int)
(assert (>= x_3 0))
(assert (<= x_3 22))
(declare-fun y_3 () Int)
(assert (>= y_3 0))
(assert (<= y_3 22))
(declare-fun x_4 () Int)
(assert (>= x_4 0))
(assert (<= x_4 22))
(declare-fun y_4 () Int)
(assert (>= y_4 0))
(assert (<= y_4 22))
(declare-fun x_5 () Int)
(assert (>= x_5 0))
(assert (<= x_5 22))
(declare-fun y_5 () Int)
(assert (>= y_5 0))
(assert (<= y_5 22))
(declare-fun area () Int)
(assert (>= area 68))
(assert (<= area 132))
(declare-fun cost () Int)
(assert (>= cost 68))
(assert (<= cost 132))
(assert (= area (* W H)))
(assert (= cost area))
(assert (<= (+ x_0 1) W))
(assert (<= (+ y_0 5) H))
(assert (<= (+ x_1 2) W))
(assert (<= (+ y_1 3) H))
(assert (<= (+ x_2 6) W))
(assert (<= (+ y_2 6) H))
(assert (<= (+ x_3 2) W))
(assert (<= (+ y_3 2) H))
(assert (<= (+ x_4 5) W))
(assert (<= (+ y_4 1) H))
(assert (<= (+ x_5 6) W))
(assert (<= (+ y_5 2) H))
(assert (or (<= (+ x_0 1) x_1) (<= (+ x_1 2) x_0) (<= (+ y_0 5) y_1) (<= (+ y_1 3) y_0)))
(assert (or (<= (+ x_0 1) x_2) (<= (+ x_2 6) x_0) (<= (+ y_0 5) y_2) (<= (+ y_2 6) y_0)))
(assert (or (<= (+ x_0 1) x_3) (<= (+ x_3 2) x_0) (<= (+ y_0 5) y_3) (<= (+ y_3 2) y_0)))
(assert (or (<= (+ x_0 1) x_4) (<= (+ x_4 5) x_0) (<= (+ y_0 5) y_4) (<= (+ y_4 1) y_0)))
(assert (or (<= (+ x_0 1) x_5) (<= (+ x_5 6) x_0) (<= (+ y_0 5) y_5) (<= (+ y_5 2) y_0)))
(assert (or (<= (+ x_1 2) x_2) (<= (+ x_2 6) x_1) (<= (+ y_1 3) y_2) (<= (+ y_2 6) y_1)))
(assert (or (<= (+ x_1 2) x_3) (<= (+ x_3 2) x_1) (<= (+ y_1 3) y_3) (<= (+ y_3 2) y_1)))
(assert (or (<= (+ x_1 2) x_4) (<= (+ x_4 5) x_1) (<= (+ y_1 3) y_4) (<= (+ y_4 1) y_1)))
(assert (or (<= (+ x_1 2) x_5) (<= (+ x_5 6) x_1) (<= (+ y_1 3) y_5) (<= (+ y_5 2) y_1)))
(assert (or (<= (+ x_2 6) x_3) (<= (+ x_3 2) x_2) (<= (+ y_2 6) y_3) (<= (+ y_3 2) y_2)))
(assert (or (<= (+ x_2 6) x_4) (<= (+ x_4 5) x_2) (<= (+ y_2 6) y_4) (<= (+ y_4 1) y_2)))
(assert (or (<= (+ x_2 6) x_5) (<= (+ x_5 6) x_2) (<= (+ y_2 6) y_5) (<= (+ y_5 2) y_2)))
(assert (or (<= (+ x_3 2) x_4) (<= (+ x_4 5) x_3) (<= (+ y_3 2) y_4) (<= (+ y_4 1) y_3)))
(assert (or (<= (+ x_3 2) x_5) (<= (+ x_5 6) x_3) (<= (+ y_3 2) y_5) (<= (+ y_5 2) y_3)))
(assert (or (<= (+ x_4 5) x_5) (<= (+ x_5 6) x_4) (<= (+ y_4 1) y_5) (<= (+ y_5 2) y_4)))
(minimize cost)
(check-sat)
