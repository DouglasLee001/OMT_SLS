; Integer minimum-trading-unit holdings; cost is exact scaled quadratic portfolio risk
(set-logic QF_NIA)
(declare-fun x1 () Int)
(assert (>= x1 0))
(assert (<= x1 3))
(declare-fun x2 () Int)
(assert (>= x2 0))
(assert (<= x2 2))
(assert (>= (+ (- 5) (* 2 x1) (* 3 x2)) 0))
(assert (<= (+ (- 6) (* 2 x1) (* 3 x2)) 0))
(assert (>= (+ (- 2) (* 1 x1) (* 1 x2)) 0))
(declare-fun cost () Int)
(assert (= cost (+ (* 3 x1 x1) (* 2 x1 x2) (* 4 x2 x2))))
