; Exact unit-duration MiniZinc rcmsp cyclic scheduling
(set-logic QF_NIA)
(declare-fun s_1 () Int)
(assert (>= s_1 0))
(assert (<= s_1 5))
(declare-fun k_1 () Int)
(assert (>= k_1 0))
(assert (<= k_1 5))
(declare-fun s_2 () Int)
(assert (>= s_2 0))
(assert (<= s_2 5))
(declare-fun k_2 () Int)
(assert (>= k_2 0))
(assert (<= k_2 5))
(declare-fun s_3 () Int)
(assert (>= s_3 0))
(assert (<= s_3 5))
(declare-fun k_3 () Int)
(assert (>= k_3 0))
(assert (<= k_3 5))
(declare-fun s_4 () Int)
(assert (>= s_4 0))
(assert (<= s_4 5))
(declare-fun k_4 () Int)
(assert (>= k_4 0))
(assert (<= k_4 5))
(declare-fun s_5 () Int)
(assert (>= s_5 0))
(assert (<= s_5 5))
(declare-fun k_5 () Int)
(assert (>= k_5 0))
(assert (<= k_5 5))
(declare-fun T () Int)
(assert (>= T 0))
(assert (<= T 5))
(assert (= T s_5))
(assert (<= (+ k_1 (ite (<= (+ s_1 0) s_2) 0 1)) (+ k_2 0)))
(assert (<= (+ k_2 (ite (<= (+ s_2 2) s_3) 0 1)) (+ k_3 0)))
(assert (<= (+ k_3 (ite (<= (+ s_3 1) s_4) 0 1)) (+ k_4 0)))
(assert (<= (+ k_4 (ite (<= (+ s_4 1) s_5) 0 1)) (+ k_5 0)))
(assert (<= (+ k_4 (ite (<= (+ s_4 1) s_2) 0 1)) (+ k_2 2)))
(assert (or (<= (+ s_2 1) s_3) (<= (+ s_3 1) s_2)))
(assert (or (<= (+ s_2 1) s_4) (<= (+ s_4 1) s_2)))
(assert (or (<= (+ s_3 1) s_4) (<= (+ s_4 1) s_3)))
(assert (<= (+ (ite (= s_2 s_2) 1 0) (ite (= s_3 s_2) 1 0) (ite (= s_4 s_2) 1 0)) 1))
(assert (<= (+ (ite (= s_2 s_3) 1 0) (ite (= s_3 s_3) 1 0) (ite (= s_4 s_3) 1 0)) 1))
(assert (<= (+ (ite (= s_2 s_4) 1 0) (ite (= s_3 s_4) 1 0) (ite (= s_4 s_4) 1 0)) 1))
(assert (>= k_5 k_1))
(assert (<= (+ s_1 0) T))
(assert (>= k_5 k_2))
(assert (<= (+ s_2 1) T))
(assert (>= k_5 k_3))
(assert (<= (+ s_3 1) T))
(assert (>= k_5 k_4))
(assert (<= (+ s_4 1) T))
(assert (or (= k_5 k_1) (= k_5 k_2) (= k_5 k_3) (= k_5 k_4)))
(assert (= s_1 0))
(assert (= k_1 0))
(declare-fun u_1 () Int)
(assert (>= u_1 (- 25)))
(assert (<= u_1 5))
(assert (= u_1 (- s_1 (* k_1 T))))
(declare-fun u_2 () Int)
(assert (>= u_2 (- 25)))
(assert (<= u_2 5))
(assert (= u_2 (- s_2 (* k_2 T))))
(declare-fun u_3 () Int)
(assert (>= u_3 (- 25)))
(assert (<= u_3 5))
(assert (= u_3 (- s_3 (* k_3 T))))
(declare-fun u_4 () Int)
(assert (>= u_4 (- 25)))
(assert (<= u_4 5))
(assert (= u_4 (- s_4 (* k_4 T))))
(declare-fun hi () Int)
(assert (>= hi (- 25)))
(assert (<= hi 5))
(declare-fun lo () Int)
(assert (>= lo (- 25)))
(assert (<= lo 5))
(assert (>= hi u_1))
(assert (<= lo u_1))
(assert (>= hi u_2))
(assert (<= lo u_2))
(assert (>= hi u_3))
(assert (<= lo u_3))
(assert (>= hi u_4))
(assert (<= lo u_4))
(assert (or (= hi u_1) (= hi u_2) (= hi u_3) (= hi u_4)))
(assert (or (= lo u_1) (= lo u_2) (= lo u_3) (= lo u_4)))
(declare-fun C () Int)
(assert (>= C 0))
(assert (<= C 5))
(assert (= C (+ (- hi lo) 1)))
(declare-fun cost () Int)
(assert (>= cost 0))
(assert (<= cost 30))
(assert (= cost (+ (* 5 T) C)))
(minimize cost)
(check-sat)
