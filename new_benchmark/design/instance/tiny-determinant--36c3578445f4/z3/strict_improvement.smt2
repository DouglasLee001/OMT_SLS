(set-option :timeout 3000)
(set-option :produce-models true)
; Exact D-optimal design; nonnegative integer repetition counts; positive Gram determinant.
(set-logic QF_NIA)
(declare-fun n_0 () Int)
(assert (>= n_0 0))
(assert (<= n_0 3))
(declare-fun n_1 () Int)
(assert (>= n_1 0))
(assert (<= n_1 3))
(declare-fun n_2 () Int)
(assert (>= n_2 0))
(assert (<= n_2 3))
(assert (= (+ n_0 n_1 n_2) 3))
(declare-fun cost () Int)
(assert (>= cost 0))
(assert (<= cost 9))
(assert (> cost 0))
(declare-fun M_0_0 () Int)
(assert (>= M_0_0 0))
(assert (<= M_0_0 3))
(assert (= M_0_0 (+ (* 1 n_0) (* 1 n_2))))
(declare-fun M_0_1 () Int)
(assert (>= M_0_1 (- 3)))
(assert (<= M_0_1 3))
(assert (= M_0_1 (* 1 n_2)))
(declare-fun M_1_1 () Int)
(assert (>= M_1_1 0))
(assert (<= M_1_1 3))
(assert (= M_1_1 (+ (* 1 n_1) (* 1 n_2))))
(assert (= cost (+ (* M_0_0 M_1_1) (- (* M_0_1 M_0_1)))))
(assert (> cost 3))
(check-sat)
