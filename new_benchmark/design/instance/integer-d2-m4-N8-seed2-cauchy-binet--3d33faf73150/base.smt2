; Exact D-optimal design; nonnegative integer repetition counts; positive Gram determinant.
(set-logic QF_NIA)
(declare-fun n_0 () Int)
(assert (>= n_0 0))
(assert (<= n_0 8))
(declare-fun n_1 () Int)
(assert (>= n_1 0))
(assert (<= n_1 8))
(declare-fun n_2 () Int)
(assert (>= n_2 0))
(assert (<= n_2 8))
(declare-fun n_3 () Int)
(assert (>= n_3 0))
(assert (<= n_3 8))
(assert (= (+ n_0 n_1 n_2 n_3) 8))
(declare-fun cost () Int)
(assert (>= cost 0))
(assert (<= cost 5184))
(assert (> cost 0))
(assert (= cost (+ (* 1 n_0 n_1) (* 9 n_0 n_2) (* 9 n_0 n_3) (* 9 n_1 n_2) (* 9 n_1 n_3))))
