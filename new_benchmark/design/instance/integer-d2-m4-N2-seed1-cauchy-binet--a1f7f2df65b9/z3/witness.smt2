(set-option :timeout 3000)
(set-option :produce-models true)
; Exact D-optimal design; nonnegative integer repetition counts; positive Gram determinant.
(set-logic QF_NIA)
(declare-fun n_0 () Int)
(assert (>= n_0 0))
(assert (<= n_0 2))
(declare-fun n_1 () Int)
(assert (>= n_1 0))
(assert (<= n_1 2))
(declare-fun n_2 () Int)
(assert (>= n_2 0))
(assert (<= n_2 2))
(declare-fun n_3 () Int)
(assert (>= n_3 0))
(assert (<= n_3 2))
(assert (= (+ n_0 n_1 n_2 n_3) 2))
(declare-fun cost () Int)
(assert (>= cost 0))
(assert (<= cost 324))
(assert (> cost 0))
(assert (= cost (+ (* 1 n_0 n_1) (* 1 n_0 n_2) (* 9 n_0 n_3) (* 4 n_1 n_2) (* 9 n_1 n_3) (* 81 n_2 n_3))))
(assert (= cost 1))
(assert (= n_0 1))
(assert (= n_1 1))
(assert (= n_2 0))
(assert (= n_3 0))
(assert (= cost 1))
(check-sat)
