(set-option :timeout 3000)
(set-option :produce-models true)
; Exact D-optimal design; nonnegative integer repetition counts; positive Gram determinant.
(set-logic QF_NIA)
(declare-fun n_0 () Int)
(assert (>= n_0 0))
(assert (<= n_0 3))
(declare-fun n_1 () Int)
(assert (>= n_1 0))
(assert (<= n_1 3))
(declare-fun n_2 () Int)
(assert (>= n_2 0))
(assert (<= n_2 3))
(assert (= (+ n_0 n_1 n_2) 3))
(declare-fun cost () Int)
(assert (>= cost 0))
(assert (<= cost 9))
(assert (> cost 0))
(assert (= cost (+ (* 1 n_0 n_1) (* 1 n_0 n_2) (* 1 n_1 n_2))))
(assert (> cost 3))
(check-sat)
