; Exact D-optimal design; nonnegative integer repetition counts; positive Gram determinant.
(set-logic QF_NIA)
(declare-fun n_0 () Int)
(assert (>= n_0 0))
(assert (<= n_0 8))
(declare-fun n_1 () Int)
(assert (>= n_1 0))
(assert (<= n_1 8))
(declare-fun n_2 () Int)
(assert (>= n_2 0))
(assert (<= n_2 8))
(declare-fun n_3 () Int)
(assert (>= n_3 0))
(assert (<= n_3 8))
(declare-fun n_4 () Int)
(assert (>= n_4 0))
(assert (<= n_4 8))
(declare-fun n_5 () Int)
(assert (>= n_5 0))
(assert (<= n_5 8))
(assert (= (+ n_0 n_1 n_2 n_3 n_4 n_5) 8))
(declare-fun cost () Int)
(assert (>= cost 0))
(assert (<= cost 256))
(assert (> cost 0))
(assert (= cost (+ (* 1 n_0 n_1) (* 4 n_0 n_2) (* 1 n_0 n_3) (* 4 n_0 n_4) (* 4 n_0 n_5) (* 1 n_1 n_2) (* 1 n_1 n_4) (* 1 n_1 n_5) (* 1 n_2 n_3) (* 1 n_3 n_4) (* 1 n_3 n_5))))
