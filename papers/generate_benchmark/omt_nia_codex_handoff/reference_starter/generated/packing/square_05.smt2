; Minimum-area square packing, original square_pack.mzn, n=5
; Source: https://github.com/MiniZinc/minizinc-examples/blob/master/square_pack.mzn
(set-logic QF_NIA)
(declare-fun width () Int)
(assert (>= width 5))
(assert (<= width 15))
(declare-fun height () Int)
(assert (>= height 5))
(assert (<= height 15))
(declare-fun cost () Int)
(assert (>= cost 55))
(assert (<= cost 75))
(assert (= cost (* width height)))
(declare-fun x1 () Int)
(assert (>= x1 0))
(assert (<= x1 15))
(declare-fun y1 () Int)
(assert (>= y1 0))
(assert (<= y1 15))
(assert (<= (+ x1 1) width))
(assert (<= (+ y1 1) height))
(declare-fun x2 () Int)
(assert (>= x2 0))
(assert (<= x2 15))
(declare-fun y2 () Int)
(assert (>= y2 0))
(assert (<= y2 15))
(assert (<= (+ x2 2) width))
(assert (<= (+ y2 2) height))
(declare-fun x3 () Int)
(assert (>= x3 0))
(assert (<= x3 15))
(declare-fun y3 () Int)
(assert (>= y3 0))
(assert (<= y3 15))
(assert (<= (+ x3 3) width))
(assert (<= (+ y3 3) height))
(declare-fun x4 () Int)
(assert (>= x4 0))
(assert (<= x4 15))
(declare-fun y4 () Int)
(assert (>= y4 0))
(assert (<= y4 15))
(assert (<= (+ x4 4) width))
(assert (<= (+ y4 4) height))
(declare-fun x5 () Int)
(assert (>= x5 0))
(assert (<= x5 15))
(declare-fun y5 () Int)
(assert (>= y5 0))
(assert (<= y5 15))
(assert (<= (+ x5 5) width))
(assert (<= (+ y5 5) height))
(assert (or (<= (+ x1 1) x2) (<= (+ x2 2) x1) (<= (+ y1 1) y2) (<= (+ y2 2) y1)))
(assert (or (<= (+ x1 1) x3) (<= (+ x3 3) x1) (<= (+ y1 1) y3) (<= (+ y3 3) y1)))
(assert (or (<= (+ x1 1) x4) (<= (+ x4 4) x1) (<= (+ y1 1) y4) (<= (+ y4 4) y1)))
(assert (or (<= (+ x1 1) x5) (<= (+ x5 5) x1) (<= (+ y1 1) y5) (<= (+ y5 5) y1)))
(assert (or (<= (+ x2 2) x3) (<= (+ x3 3) x2) (<= (+ y2 2) y3) (<= (+ y3 3) y2)))
(assert (or (<= (+ x2 2) x4) (<= (+ x4 4) x2) (<= (+ y2 2) y4) (<= (+ y4 4) y2)))
(assert (or (<= (+ x2 2) x5) (<= (+ x5 5) x2) (<= (+ y2 2) y5) (<= (+ y5 5) y2)))
(assert (or (<= (+ x3 3) x4) (<= (+ x4 4) x3) (<= (+ y3 3) y4) (<= (+ y4 4) y3)))
(assert (or (<= (+ x3 3) x5) (<= (+ x5 5) x3) (<= (+ y3 3) y5) (<= (+ y5 5) y3)))
(assert (or (<= (+ x4 4) x5) (<= (+ x5 5) x4) (<= (+ y4 4) y5) (<= (+ y5 5) y4)))
(minimize cost)
(check-sat)
(get-model)
(get-objectives)
