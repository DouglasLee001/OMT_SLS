(assert (>= width 10))
(assert (<= width 55))
(declare-fun height () Int)
(assert (>= height 10))
(assert (<= height 55))
(declare-fun cost () Int)
(assert (>= cost 385))
(assert (<= cost 550))
(assert (= cost (* width height)))
