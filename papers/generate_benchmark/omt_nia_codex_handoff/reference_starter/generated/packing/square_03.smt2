; Minimum-area square packing, original square_pack.mzn, n=3
; Source: https://github.com/MiniZinc/minizinc-examples/blob/master/square_pack.mzn
(set-logic QF_NIA)
(declare-fun width () Int)
(assert (>= width 3))
(assert (<= width 6))
(declare-fun height () Int)
(assert (>= height 3))
(assert (<= height 6))
(declare-fun cost () Int)
(assert (>= cost 14))
(assert (<= cost 18))
(assert (= cost (* width height)))
(declare-fun x1 () Int)
(assert (>= x1 0))
(assert (<= x1 6))
(declare-fun y1 () Int)
(assert (>= y1 0))
(assert (<= y1 6))
(assert (<= (+ x1 1) width))
(assert (<= (+ y1 1) height))
(declare-fun x2 () Int)
(assert (>= x2 0))
(assert (<= x2 6))
(declare-fun y2 () Int)
(assert (>= y2 0))
(assert (<= y2 6))
(assert (<= (+ x2 2) width))
(assert (<= (+ y2 2) height))
(declare-fun x3 () Int)
(assert (>= x3 0))
(assert (<= x3 6))
(declare-fun y3 () Int)
(assert (>= y3 0))
(assert (<= y3 6))
(assert (<= (+ x3 3) width))
(assert (<= (+ y3 3) height))
(assert (or (<= (+ x1 1) x2) (<= (+ x2 2) x1) (<= (+ y1 1) y2) (<= (+ y2 2) y1)))
(assert (or (<= (+ x1 1) x3) (<= (+ x3 3) x1) (<= (+ y1 1) y3) (<= (+ y3 3) y1)))
(assert (or (<= (+ x2 2) x3) (<= (+ x3 3) x2) (<= (+ y2 2) y3) (<= (+ y3 3) y2)))
(minimize cost)
(check-sat)
(get-model)
(get-objectives)
